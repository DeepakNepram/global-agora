# The moderate-post Edge Function's settings (Prompt 4.3).
#
# Locally: copy to supabase/functions/.env (gitignored), then restart the
# stack (npm run db:stop && npm run db:start). Hosted: set the three secrets
# with `supabase secrets set`, never these local values.

# Must match the database's Vault entry moderation_hook_secret. The local
# seed (supabase/seeds/local-moderation.sql) uses this public value; a hosted
# project needs its own long random one.
MODERATION_HOOK_SECRET=local-only-moderation-hook

# Model keys. Leave one empty locally and that model is served by db:smoke's
# stand-in, which replays the replies in _shared/moderation/fixtures.json.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local only: where the stand-in listens (db:smoke starts it on the host's
# port 54399). 192.168.65.254 is Docker Desktop's address for the host; the
# Supabase network does not resolve host.docker.internal. On Linux Docker,
# use the network's gateway. Refused against a hosted project.
MODERATION_STAND_IN_URL=http://192.168.65.254:54399

# The suggest-debate function (Prompt 4.6). With no key it still answers,
# with no suggestion, and the admin types the debate's words. Hosted:
# `supabase secrets set ANTHROPIC_API_KEY=...` (never commit or paste it).
ANTHROPIC_API_KEY=
# Optional tuning; these are the defaults.
DEBATE_MODEL=claude-opus-5-5
DEBATE_EFFORT=medium
# Local only: with no key, db:smoke's stand-in answers instead (host port
# 54398). Refused against a hosted project.
DEBATE_STAND_IN_URL=http://192.168.65.254:54398
