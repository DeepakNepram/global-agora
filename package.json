{
  "name": "global-agora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browse world news on a cinematic 3D globe, scrub the last 24 hours, and debate hot stories.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "textures:fetch": "node --experimental-strip-types scripts/fetch-textures.ts",
    "textures:build": "node --experimental-strip-types scripts/process-textures.ts",
    "textures": "npm run textures:fetch && npm run textures:build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:seed:generate": "node --experimental-strip-types scripts/seed/generate.ts",
    "db:smoke": "node --experimental-strip-types scripts/db/smoke.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/core/db/types.ts && prettier --write src/core/db/types.ts",
    "ingest:dev": "wrangler dev -c workers/ingest/wrangler.jsonc --test-scheduled",
    "ingest:replay": "node --experimental-strip-types scripts/ingest/replay.ts",
    "ingest:data": "node --experimental-strip-types scripts/ingest/build-data.ts",
    "api:dev": "wrangler dev -c workers/api/wrangler.jsonc",
    "api:measure": "node --experimental-strip-types scripts/api/measure.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.117.1",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.137.0"
  }
}
