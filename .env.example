# Global Agora — environment variables
# Copy to .env.local for local dev:  cp .env.example .env.local
# .env* is gitignored. Never commit real values.

# ============================================================================
# CLIENT — anything prefixed VITE_ is INLINED INTO THE PUBLIC BUNDLE.
# Treat every value below as world-readable. No service keys here, ever.
# (CLAUDE.md hard constraint #9.)
# ============================================================================

# Supabase project URL and anon key. The anon key is safe to ship *only* because
# every table has RLS (hard constraint #8).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ways to sign in, comma separated: google, apple, email. Each must be set up
# in Supabase first (Google and Apple need their own credentials); an unlisted
# one shows no button. Blank means email alone.
VITE_AUTH_PROVIDERS=

# Base URL of the Cloudflare Workers API that serves the columnar payload.
# Leave blank to use /api: same origin in production, Vite's proxy in dev.
VITE_API_BASE_URL=
# How often the globe re-checks the payload (an unchanged check is a 304).
VITE_PAYLOAD_REFRESH_SECONDS=120

# Sentry browser DSN. A DSN is public by design. Unset: no crash reports.
VITE_SENTRY_DSN=

# --- Who runs it (Prompt 5.2). Shown in the legal pages and Contact. --------
# A real inbox: the Contact page, the privacy policy and appeals point here.
VITE_CONTACT_EMAIL=
# The person or organisation running the service, and its country (the
# terms' governing law).
VITE_OPERATOR_NAME=
VITE_OPERATOR_COUNTRY=
# Where the Supabase project keeps data, as the privacy policy says it,
# e.g. "the EU (Frankfurt)".
VITE_DATA_REGION=

# Before a production build, `npm run deploy:check` checks all of the above
# as the build will see them, without printing any value.

# --- Monetization hooks. Config values, never hardcoded limits. -------------
# Free-tier defaults live in src/core/config.ts; these override them.
VITE_HISTORY_WINDOW_HOURS=24
VITE_SAVED_STORY_LIMIT=50
VITE_ALERT_LIMIT=5
VITE_MAX_POST_LENGTH=500

# ============================================================================
# SERVER — Cloudflare Workers and local tooling only.
# NOT prefixed with VITE_, so Vite will not expose them. In production these are
# Worker secrets (`wrangler secret put NAME`), not files.
# ============================================================================

# Supabase, privileged. Bypasses RLS — Workers only. The ingest Worker reads
# these from workers/ingest/.dev.vars locally (see .dev.vars.example there).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# The API Worker reads with the publishable key only, never the service key
# (workers/api/.dev.vars locally).
SUPABASE_ANON_KEY=

# News ingest. GDELT needs no key. The GKG file feed; the GEO 2.0 API it
# pointed at before now returns 404 (docs/DECISIONS.md).
GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2
RSS_FEED_LIST_URL=

# Geocoding fallback for the stories GDELT does not place.
# Nominatim's usage policy requires a real contact string in the User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=

# Moderation. Two layers because they catch different things.
OPENAI_API_KEY=
PERSPECTIVE_API_KEY=

# Bearer secret for the ingest Worker's manual POST /run (32+ characters).
# The cron trigger needs none: Cloudflare invokes it internally.
INGEST_TRIGGER_SECRET=
# Guards the admin queue that opens discussions.
ADMIN_API_TOKEN=

# Analytics (Prompt 5.2): Umami Cloud's website id, an API Worker secret
# (`wrangler secret put UMAMI_WEBSITE_ID`). Unset: events are accepted and
# dropped. The Worker forwards the six events without the reader's IP.
UMAMI_WEBSITE_ID=

# Source-map upload at deploy (Prompt 5.2): SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT go in the gitignored .env.sentry-build-plugin, which
# @sentry/vite-plugin reads itself. Without them the build uploads nothing.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Not read yet: the Workers report to Workers Logs (observability in each
# wrangler.jsonc), not Sentry.
SENTRY_DSN=

# Cloudflare deploy credentials (CI uses repository secrets, not this file).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
