# Global Agora — environment variables
# Copy to .env.local for local dev:  cp .env.example .env.local
# .env* is gitignored. Never commit real values.

# ============================================================================
# CLIENT — anything prefixed VITE_ is INLINED INTO THE PUBLIC BUNDLE.
# Treat every value below as world-readable. No service keys here, ever.
# (CLAUDE.md hard constraint #9.)
# ============================================================================

# Supabase project URL and anon key. The anon key is safe to ship *only* because
# every table has RLS (hard constraint #8).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Cloudflare Workers API that serves the columnar payload.
# Leave blank to use the dev proxy default of /api.
VITE_API_BASE_URL=

# Sentry browser DSN. A DSN is public by design.
VITE_SENTRY_DSN=

# --- Monetization hooks. Config values, never hardcoded limits. -------------
# Free-tier defaults live in src/core/config.ts; these override them.
VITE_HISTORY_WINDOW_HOURS=24
VITE_SAVED_STORY_LIMIT=50
VITE_ALERT_LIMIT=5
VITE_MAX_POST_LENGTH=500

# ============================================================================
# SERVER — Cloudflare Workers and local tooling only.
# NOT prefixed with VITE_, so Vite will not expose them. In production these are
# Worker secrets (`wrangler secret put NAME`), not files.
# ============================================================================

# Supabase, privileged. Bypasses RLS — Workers only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# News ingest. GDELT needs no key; it is a base URL so it can be pinned or mocked.
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
RSS_FEED_LIST_URL=

# Geocoding fallback for the stories GDELT does not place.
# Nominatim's usage policy requires a real contact string in the User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=

# Moderation. Two layers because they catch different things.
OPENAI_API_KEY=
PERSPECTIVE_API_KEY=

# Shared secret the cron trigger presents to the ingest endpoint.
INGEST_CRON_SECRET=
# Guards the admin queue that opens discussions.
ADMIN_API_TOKEN=

# Server-side Sentry.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare deploy credentials (CI uses repository secrets, not this file).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
